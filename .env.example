# Copiá este archivo como .env para docker compose (local).
# En ECS estos valores van como variables de entorno / secretos de la task definition.

MYSQL_ROOT_PASSWORD=cambiame-root
DB_NAME=trivia
DB_USER=trivia
DB_PASSWORD=cambiame-db

# Contraseña para entrar al panel de admin (lápiz en la app)
ADMIN_PASSWORD=cambiame-admin

# Secreto para firmar las sesiones de admin. Generalo con: openssl rand -hex 32
TOKEN_SECRET=reemplazar-por-un-valor-largo-y-aleatorio
