{
  "cluster": "trivia",
  "serviceName": "trivia-mysql",
  "taskDefinition": "trivia-mysql",
  "desiredCount": 1,
  "launchType": "FARGATE",
  "deploymentConfiguration": {
    "minimumHealthyPercent": 0,
    "maximumPercent": 100
  },
  "networkConfiguration": {
    "awsvpcConfiguration": {
      "subnets": ["<PRIVATE_SUBNET_1>", "<PRIVATE_SUBNET_2>"],
      "securityGroups": ["<SG_MYSQL>"],
      "assignPublicIp": "DISABLED"
    }
  },
  "serviceConnectConfiguration": {
    "enabled": true,
    "namespace": "trivia.local",
    "services": [
      {
        "portName": "mysql",
        "discoveryName": "mysql",
        "clientAliases": [ { "port": 3306, "dnsName": "mysql" } ]
      }
    ]
  }
}
